# Base URL of a real running oscu-gateway backend. Leave unset to use relative paths (fine
# when MSW mocks are handling every request, which is the default — see docs/frontend_README.md).
# VITE_API_BASE_URL=http://localhost:8000

# Set to "false" once VITE_API_BASE_URL points at a real backend you want to hit for real.
# Unset (or anything else) keeps MSW mocks on, which is the default and lets the app run with
# no backend at all.
# VITE_ENABLE_MOCKS=false
