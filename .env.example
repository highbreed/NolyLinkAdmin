# Where Vite's dev-server proxy forwards /v1, /admin, /oauth requests (server-side only,
# never exposed to the client bundle — the backend has no CORS middleware, so the frontend
# always fetches same-origin relative paths and lets this proxy do the cross-origin part).
# BACKEND_PROXY_TARGET=http://localhost:8010

# Set to "true" once a real backend is reachable through the proxy above, to stop mocking
# login/admin-users/device-init/billing and let those specific calls through for real.
# Unset (or anything else) keeps everything mocked, which is the default and needs no backend
# running at all.
# VITE_USE_REAL_BACKEND=true

# For a production build served from a different origin than the API (with its own reverse
# proxy/CORS already configured) — not needed for local dev, which uses the proxy above instead.
# VITE_API_BASE_URL=https://api.example.com
